{
  "model": "opus",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mempalace-hook-wrapper.sh precompact",
            "timeout": 210
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "question-visibility-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "guard_tmux_kill.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mempalace-hook-wrapper.sh stop",
            "timeout": 210
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "example": {
      "source": {
        "source": "github",
        "repo": "example/example"
      }
    }
  }
}
