{
  "extraKnownMarketplaces": {
    "example": {
      "source": {
        "repo": "example/example",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "mempalace-hook-wrapper.sh precompact",
            "timeout": 210,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "question-visibility-guard.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "guard_tmux_kill.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '<HOME>/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "mempalace-hook-wrapper.sh stop",
            "timeout": 210,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus"
}